    "start": "node dist/main.js"
  },
  "dependencies": {
    "@datalust/winston-seq": "^2.0.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "dotenv": "^16.4.7",
    "joi": "^18.2.1",
    "js-base64": "^3.7.8",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
