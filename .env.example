# Helios
HELIOS_CREDENTIAL_FILE=helios.account.json

# Scheduling (default: iedere dag om 05:00)
CRON_MAAK_ROOSTER=0 5 * * *
CRON_TIMEZONE=Europe/Amsterdam
# Aantal dagen vooruit waarvoor een rooster moet bestaan
ROOSTER_DAGEN_VOORUIT=365
# Bij opstarten direct één keer uitvoeren
ROOSTER_RUN_ON_STARTUP=false

# DDWV instellingen (overeenkomstig $ddwv in Helios include/config.php)
DDWV=true
DDWV_START=04-01
DDWV_EIND=10-31

# Seq logging
LOGGER_SERVER_URL=http://seq:5341
LOGGER_API_KEY=
LOGGER_LEVEL=info
INSTANCE=Local
